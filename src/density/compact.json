{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "{size.radius.sm}" },
    "md": { "$value": "{size.radius.sm}" },
    "lg": { "$value": "{size.radius.md}" }
  },
  "body-text": {
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{size.font.xs}" },
      "md": { "$value": "{size.font.sm}" }
    }
  },
  "heading": {
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{size.font.md}" },
      "md": { "$value": "{size.font.lg}" },
      "lg": { "$value": "{size.font.xl}" }
    }
  },
  "code": {
    "font-size": {
      "$type": "dimension",
      "sm": { "$value": "{size.font.xs}" },
      "md": { "$value": "{size.font.xs}" },
      "lg": { "$value": "{size.font.sm}" }
    }
  },
  "size": {
    "$type": "dimension",
    "spacing": {
      "xs": { "$value": "2px" },
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" }
    }
  }
}
